# Copy this file to .env.local and fill in your actual values
# Get these values from your Supabase Dashboard -> Settings -> API

# Your Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Your Supabase anon/public key (safe to expose to the client)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# Your Supabase service role key (KEEP THIS SECRET - never expose to client)
# This key bypasses Row Level Security and is required for the app to work
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-here

# Environment
NODE_ENV=development

